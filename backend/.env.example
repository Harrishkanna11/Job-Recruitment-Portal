PORT=5000
NODE_ENV=development
# For PostgreSQL connection (Local, Supabase, Neon, Render, etc.):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hirehub_db
# Or separate PG config:
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hirehub_db
PG_USER=postgres
PG_PASSWORD=postgres

# If PostgreSQL is not running locally, HireHub automatically uses SQLite in dev for zero-setup demo
USE_SQLITE=auto

JWT_SECRET=hirehub_super_secret_jwt_key_2026_dev_mode_token!
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/resumes
